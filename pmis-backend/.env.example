# ============================================================
# PMIS Database Configuration
# ============================================================

# ------------------------------------------------------------
# MariaDB
# 기존 개발 환경
# ------------------------------------------------------------
PMIS_MARIADB_URL=jdbc:mariadb://localhost:3306/pmis

# Development
PMIS_MARIADB_DEV_USERNAME=root
PMIS_MARIADB_DEV_PASSWORD=

# Production
PMIS_MARIADB_PROD_USERNAME=pmis_app
PMIS_MARIADB_PROD_PASSWORD=


# ------------------------------------------------------------
# PostgreSQL
# PMIS 독립 데이터 플랫폼
# ------------------------------------------------------------
PMIS_POSTGRESQL_URL=jdbc:postgresql://localhost:5432/pmis

# Development
PMIS_POSTGRESQL_DEV_USERNAME=pmis_migrator
PMIS_POSTGRESQL_DEV_PASSWORD=

# Production
PMIS_POSTGRESQL_PROD_USERNAME=pmis_app
PMIS_POSTGRESQL_PROD_PASSWORD=

# Test
# Integration Test 전용 DB: pmis_test
PMIS_POSTGRESQL_TEST_URL=jdbc:postgresql://localhost:5432/pmis_test

# Application 계정: 일반 CRUD
PMIS_POSTGRESQL_TEST_USERNAME=pmis_app
PMIS_POSTGRESQL_TEST_PASSWORD=

# Migration 계정: Flyway 전용
PMIS_POSTGRESQL_TEST_MIGRATOR_USERNAME=pmis_migrator
PMIS_POSTGRESQL_TEST_MIGRATOR_PASSWORD=


# ============================================================
# JWT Configuration
# ============================================================

# Base64-encoded secret
# HS256 사용 시 최소 256 bits
JWT_SECRET=


# ============================================================
# Automation Runtime Configuration
# ============================================================

RUNTIME_API_BASE_URL=http://127.0.0.1:8000
RUNTIME_API_KEY=


# ============================================================
# PMIS Backend Configuration
# ============================================================

SERVER_PORT=8765